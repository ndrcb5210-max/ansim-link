<?xml version="1.0" encoding="utf-8"?>
<!--
  SEND_SMS / READ_SMS 는 어떤 단계에서도 추가하지 않는다(CLAUDE.md 원칙 5).

  3단계에서 추가한 것:
  - POST_NOTIFICATIONS: 재난문자를 감지했을 때 '위치를 공유할까요?' 알림을 띄우려면 필요하다
    (Android 13 부터 런타임 권한). 거절해도 앱은 돌아가고, 발동 기록 화면에서 확인할 수 있다.
  - 알림 접근(NotificationListenerService): 권한 선언이 아니라 서비스 선언이다.
    사용자가 시스템 설정에서 직접 켜야 하고, 런타임 권한 요청으로는 받을 수 없다.

  4단계에서 추가한 것(위치 공유):
  - ACCESS_COARSE/FINE_LOCATION: 공유하는 동안에만 쓴다. 설명 화면을 먼저 보여 준 뒤 요청한다.
  - FOREGROUND_SERVICE + FOREGROUND_SERVICE_LOCATION: 공유는 포그라운드 서비스로만 돌고
    상시 알림이 항상 보인다(CLAUDE.md 원칙 2).
  - ACCESS_BACKGROUND_LOCATION: **선택 기능인 '자동 시작' 모드에만 필요하다.**
    기본 '한 번 눌러 시작' 모드는 사용자가 알림을 눌러 시작하므로 이 권한이 없어도 된다.
    권한이 없으면 자동 시작이 꺼지고 기본 모드로 돌아간다
    (io/.../domain/share/AutoStartMode.kt).
  - RECEIVE_BOOT_COMPLETED 는 넣지 않는다. 재부팅 뒤 공유를 되살리지 않는다.
    세션은 길어도 180분이고, 사용자가 모르는 사이에 위치 수집이 되살아나면 안 된다.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!--
      위치가 없는 기기(태블릿 등)에서도 설치되게 둔다. 위치 공유는 선택 기능이고
      안심 메시지만 보내는 길이 따로 있다.
    -->
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />

    <application
        android:name=".AnsimLinkApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AnsimLink">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.AnsimLink">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          재난문자 앱이 띄운 알림을 읽는 리스너.

          BIND_NOTIFICATION_LISTENER_SERVICE 는 시스템만 가질 수 있는 권한이라,
          여기에 적어 두면 '시스템만 이 서비스를 묶을 수 있다'는 뜻이 된다.
          허용 목록 밖 알림은 서비스 안에서 곧바로 버린다
          (io/github/ndrcb5210max/ansimlink/domain/alert/AlertPackages.kt).
        -->
        <service
            android:name=".service.DisasterAlertListenerService"
            android:exported="true"
            android:label="@string/detection_service_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
          위치 공유 포그라운드 서비스.

          foregroundServiceType="location" 이라 ACCESS_FINE/COARSE_LOCATION 이 있어야
          startForeground 가 통과한다. 권한이 빠지면 SecurityException 이 나는데
          서비스 안에서 받아 '공유를 시작하지 못했습니다' 알림으로 바꾼다.

          exported="false": 다른 앱이 이 서비스를 띄워 위치를 켜게 할 수 없다.
          stopWithTask="true": 사용자가 최근 앱 목록에서 앱을 밀어 치우면 공유도 멈춘다.
            기본값(false)이면 앱을 치운 뒤에도 위치 수집이 이어진다. 그게 '숨기지 않는다'
            원칙과 어긋나지는 않지만(상시 알림은 남는다), 앱을 치운 사용자는 멈추려는
            뜻이었을 가능성이 높다고 봤다.
        -->
        <service
            android:name=".service.LocationShareService"
            android:exported="false"
            android:foregroundServiceType="location"
            android:stopWithTask="true" />

        <!-- 발동 알림의 버튼(공유 시작 / 안심 메시지만 보내기 / 닫기)을 받는다. -->
        <receiver
            android:name=".service.AlertActionReceiver"
            android:exported="false" />

        <!--
          FCM 수신. 그룹 구성원이 보낸 안심 메시지와 공유 시작 알림을 받는다.

          BIND_FIREBASE_MESSAGING_SERVICE 는 시스템(Play 서비스)만 가질 수 있는 권한이라,
          exported="true" 여도 다른 앱이 가짜 메시지를 밀어 넣을 수 없다.
        -->
        <service
            android:name=".service.AnsimMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- 푸시 알림에 쓰는 기본 아이콘·채널. 서버가 지정하지 않을 때 쓰인다. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification_share" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="safety_message" />
    </application>

</manifest>
