    <!-- ============ 4단계: 위치 공유와 안심 메시지 ============ -->

    <!-- 알림 채널 -->
    <string name="channel_sharing_name">위치 공유 중</string>
    <string name="channel_sharing_description">내 위치를 그룹에 공유하는 동안 계속 보이는 알림입니다. 공유 중임을 숨기지 않기 위한 것이므로 끄지 않는 편이 좋습니다.</string>
    <string name="channel_message_name">안심 메시지</string>
    <string name="channel_message_description">그룹 구성원이 보낸 안심 메시지와 공유 시작 알림입니다.</string>

    <!-- 공유 중 상시 알림 -->
    <string name="sharing_notification_title">%1$s에 내 위치를 공유 중 · %2$d명</string>
    <string name="sharing_notification_body">%1$s 시작 · %2$s 종료 예정</string>
    <string name="sharing_action_stop">지금 중지</string>
    <string name="sharing_action_view_location">위치 보기</string>

    <!-- 공유 시작에 실패했을 때 -->
    <string name="sharing_failed_title">위치 공유를 시작하지 못했습니다</string>
    <string name="sharing_failed_foreground">지금은 위치 공유를 시작할 수 없습니다. 앱을 열고 ‘지금 공유’를 눌러 주세요.</string>
    <string name="sharing_tap_to_start_title">위치를 공유할까요?</string>
    <string name="sharing_tap_to_start_body">자동 시작을 켜 두었지만 지금은 바로 시작할 수 없었습니다. 아래 ‘공유 시작’을 눌러 주세요.</string>

    <!-- 공유를 시작할 수 없는 이유 -->
    <string name="share_blocked_not_signed_in">로그인한 뒤에 공유할 수 있습니다.</string>
    <string name="share_blocked_no_group">안심 그룹이 없습니다. 그룹을 만들거나 초대 코드로 참여해 주세요.</string>
    <string name="share_blocked_consent_withdrawn">위치 제공 동의를 철회한 상태입니다. 다시 공유하려면 초대 코드로 그룹에 참여해 주세요.</string>
    <string name="share_blocked_paused">공유를 일시중지해 두었습니다. 그룹 화면에서 ‘다시 공유’를 눌러 주세요.</string>
    <string name="share_blocked_location_permission">위치 권한이 필요합니다. 앱에서 설명을 읽고 허용해 주세요.</string>
    <string name="share_blocked_already_sharing">이미 위치를 공유하고 있습니다.</string>
    <string name="share_blocked_background_location">자동 시작에는 위치 권한을 ‘항상 허용’으로 두어야 합니다.</string>

    <!-- 다른 구성원이 보낸 것 -->
