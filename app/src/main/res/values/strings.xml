    <string name="create_group_name_hint">예: 우리 가족</string>
    <string name="create_group_notice">그룹을 만들면 내 위치를 이 그룹 구성원에게 제공하는 데 동의한 것으로 기록합니다. 나중에 그룹 화면에서 일시중지하거나 철회할 수 있습니다.</string>
    <string name="create_group_submit">만들기</string>

