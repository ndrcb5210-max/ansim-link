    <!-- 안심 메시지 편집 -->
    <string name="message_title">안심 메시지</string>
    <string name="message_intro">발동했을 때 그룹 구성원에게 보낼 문구입니다. 앱 푸시로만 가고 문자(SMS)로는 보내지 않습니다.</string>
    <string name="message_common_label">공통 메시지</string>
    <string name="message_common_hint">예: 재난문자 받았어. 나는 괜찮아.</string>
    <string name="message_length">%1$d / %2$d자</string>
    <string name="message_reset">기본 문구로 되돌리기</string>
    <string name="message_per_type_title">재난 유형별 메시지</string>
    <string name="message_per_type_premium">프리미엄 구독에서 재난 유형마다 다른 문구를 쓸 수 있습니다. 무료 요금제에서는 공통 메시지만 갑니다.</string>
