    <string name="sharing_started_body">%1$s님이 내 위치를 공유하기 시작했습니다.</string>

    <!-- 홈 화면의 공유 상태 -->
    <string name="home_sharing_state_active">공유 중</string>
    <string name="home_sharing_active_description">%1$s에 내 위치를 공유하고 있습니다. %2$s에 자동으로 끝납니다(%3$d분 남음).</string>
    <string name="home_sharing_start">지금 공유</string>
