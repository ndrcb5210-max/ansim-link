    <string name="confidence_low">낮음</string>

    <!-- 발동 여부의 이유 -->
    <string name="reason_triggered">규칙에 맞아 발동했습니다.</string>
    <string name="reason_severity_unknown">문자 종류를 알 수 없어 발동하지 않았습니다.</string>
    <string name="reason_severity_disabled">이 문자 종류는 발동하지 않도록 설정돼 있습니다.</string>
