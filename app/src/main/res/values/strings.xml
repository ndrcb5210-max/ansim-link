    <!-- 위치 권한 설명 화면 (명시적 공개) -->
    <string name="location_disclosure_title">위치 공유를 켜기 전에</string>
    <string name="location_disclosure_what_title">무엇을 하나요?</string>
    <string name="location_disclosure_what_body">재난문자를 받았을 때 내 위치(위도·경도·시각·정확도)를 안심 그룹 구성원에게 정해진 시간 동안 공유합니다. 공유는 내가 시작할 때만 시작합니다.</string>
    <string name="location_disclosure_when_title">언제 수집하나요?</string>
    <string name="location_disclosure_when_body">공유하는 동안에만 수집합니다. 공유가 끝나면 위치 수집도 함께 멈춥니다. 공유 중에는 상시 알림과 앱 안 배너가 항상 보입니다.</string>
    <string name="location_disclosure_how_long_title">얼마나 보관하나요?</string>
    <string name="location_disclosure_how_long_body">공유가 끝나면 마지막 위치 1건만 남기고 나머지는 남기지 않습니다. 그 1건도 24시간이 지나면 지웁니다. 이동 경로는 쌓지 않습니다.</string>
    <string name="location_disclosure_who_title">누가 볼 수 있나요?</string>
    <string name="location_disclosure_who_body">내가 참여한 안심 그룹의 구성원만 볼 수 있습니다. 누가 볼 수 있는지는 그룹 화면에서 언제든 확인할 수 있고, 일시중지와 동의 철회는 한 번 눌러 바로 반영됩니다.</string>
    <string name="location_disclosure_allow">위치 권한 허용</string>
    <string name="location_disclosure_granted">위치 권한이 켜져 있습니다.</string>

    <!-- 자동 시작 -->
    <string name="auto_start_title">자동 시작</string>
    <string name="auto_start_summary_off">꺼짐 — 재난문자를 감지하면 알림으로 여쭤봅니다.</string>
    <string name="auto_start_summary_on">켜짐 — 재난문자를 감지하면 바로 공유를 시작합니다.</string>
    <string name="auto_start_disclosure_title">앱을 쓰지 않을 때도 위치를 수집합니다</string>
    <string name="auto_start_disclosure_body">자동 시작을 켜면, <b>앱이 닫혀 있거나 사용하지 않을 때도</b> 재난문자를 받으면 안심연결이 내 위치를 수집해 안심 그룹 구성원에게 공유합니다.</string>
    <string name="auto_start_disclosure_uses_title">이 위치를 쓰는 기능</string>
    <string name="auto_start_disclosure_use_share">안심 그룹 구성원에게 내 실시간 위치 공유(정해진 시간 동안)</string>
    <string name="auto_start_disclosure_use_distance">가족 위치 보기 화면의 거리 계산</string>
    <string name="auto_start_disclosure_use_none">위치는 이 두 가지 외에 어디에도 쓰지 않습니다. 광고나 분석에 쓰지 않고 다른 회사에 넘기지 않습니다.</string>
    <string name="auto_start_disclosure_optional">자동 시작은 선택입니다. 켜지 않아도 알림을 눌러 공유를 시작할 수 있고, 안심 메시지는 자동으로 보낼 수 있습니다.</string>
    <string name="auto_start_disclosure_accept">이해했습니다, 계속</string>
    <string name="auto_start_step_location_title">1단계 — 위치 권한</string>
    <string name="auto_start_step_location_body">먼저 위치 권한이 필요합니다.</string>
    <string name="auto_start_step_background_title">2단계 — ‘항상 허용’으로 바꾸기</string>
    <string name="auto_start_step_background_body">앱을 쓰지 않을 때도 위치를 받으려면 시스템 설정에서 위치 권한을 ‘항상 허용’으로 바꿔야 합니다. 아래 버튼을 누르면 그 설정 화면이 열립니다.</string>
    <string name="auto_start_step_background_button">위치 권한 설정 열기</string>
    <string name="auto_start_ready">준비가 끝났습니다. 아래에서 자동 시작을 켤 수 있습니다.</string>
    <string name="auto_start_fallback_notice">권한이 빠지면 자동 시작은 저절로 꺼지고, 알림을 눌러 시작하는 기본 방식으로 돌아갑니다.</string>

