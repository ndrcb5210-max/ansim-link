    <!-- 홈 -->
    <string name="home_intro">재난문자를 받으면 안심 그룹에 내 위치와 안심 메시지를 보냅니다.</string>
    <string name="home_detection_title">재난문자 감지</string>
    <string name="home_detection_state_off">꺼짐</string>
    <string name="home_detection_description">아직 켜지 않았습니다. 감지를 켜려면 알림 접근 권한이 필요합니다. 휴대폰 기종·통신사·알림 설정에 따라 감지되지 않을 수 있습니다.</string>
    <string name="home_sharing_title">위치 공유</string>
    <string name="home_sharing_state_idle">공유 중이 아님</string>
    <string name="home_sharing_description">지금은 위치를 수집하거나 보내지 않습니다. 공유는 내가 동의하고 시작할 때만 시작하며, 공유하는 동안에는 항상 알림을 보여 줍니다.</string>

    <!-- 그룹 -->
    <string name="group_empty_title">아직 그룹이 없습니다</string>
    <string name="group_empty_description">안심 그룹을 만들고 초대 코드를 가족에게 보내 주세요. 초대받은 사람이 직접 동의해야 그룹에 들어옵니다.</string>
    <string name="group_create">그룹 만들기</string>
