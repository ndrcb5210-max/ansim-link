    <!-- 받은 알림 패키지 기록 (디버그 전용) -->
    <string name="observed_title">받은 알림 패키지 기록</string>
    <string name="observed_intro">디버그 빌드에서만 쌓입니다. 재난문자 앱이 아닌 알림은 앱의 패키지 이름만 적고 제목·본문은 읽지 않습니다. 이 기기의 재난문자 앱 이름을 찾는 데 씁니다.</string>
    <string name="observed_empty">아직 기록이 없습니다. 다른 앱의 알림이 오면 여기에 쌓입니다.</string>
    <string name="observed_count">%1$d번 · 마지막 %2$s</string>
    <string name="observed_clear">목록 지우기</string>
    <string name="observed_known_badge">허용 목록</string>

    <!-- 테스트 재난문자 (디버그 전용) -->
    <string name="debug_test_alert_title">테스트 재난문자 보내기</string>
    <string name="debug_test_alert_body">앱이 재난문자와 같은 모양의 알림을 직접 띄웁니다. 그 알림을 우리 리스너가 읽어 분류 → 규칙 → 기록 → 발동까지 가는지 확인할 수 있습니다. 실제 재난문자가 아닙니다.</string>
    <string name="debug_test_alert_send">%1$s로 보내기</string>
    <string name="debug_test_alert_sent">테스트 알림을 띄웠습니다. 알림창과 발동 기록을 확인해 주세요.</string>
    <string name="debug_test_alert_failed">알림 권한이 꺼져 있어 띄울 수 없습니다. 감지 설정 화면에서 알림 권한을 켜 주세요.</string>
