    <string name="detection_not_stored_item_others">재난문자 앱이 아닌 앱의 알림은 앱 이름만 보고 바로 버립니다. 제목과 본문은 읽지 않습니다.</string>
    <string name="detection_not_stored_item_body">재난문자 본문은 앞 %1$d자까지만 이 휴대폰 안에 기록하고, %2$d일이 지나면 지웁니다.</string>
    <string name="detection_not_stored_item_server">알림 내용은 서버로 보내지 않습니다. 감지와 기록은 모두 이 휴대폰 안에서만 일어납니다.</string>
    <string name="detection_target_packages_title">읽는 앱 목록</string>
    <string name="detection_no_guarantee_title">알아 두실 점</string>
    <string name="detection_no_guarantee_body">모든 재난문자를 감지한다고 보장할 수 없습니다. 휴대폰 기종, 통신사, 재난문자 앱의 알림 설정, 제조사가 바꾼 앱 이름에 따라 알림이 오지 않거나 모양이 달라 알아보지 못할 수 있습니다. Android 15 부터는 알림 내용이 가려져 올 수도 있습니다. 재난문자 자체는 휴대폰이 그대로 보여 주니 그쪽을 먼저 확인해 주세요.</string>
    <string name="detection_open_settings">알림 접근 설정 열기</string>
    <string name="detection_settings_not_found">이 기기에서는 알림 접근 설정 화면을 열 수 없었습니다. 설정 앱에서 ‘알림 접근’ 또는 ‘특수 앱 접근’을 찾아 주세요.</string>
    <string name="detection_restricted_title">설정에서 켤 수 없나요?</string>
    <string name="detection_restricted_body">스토어가 아닌 파일(APK)로 설치한 앱은 Android 13 부터 ‘제한된 설정’ 때문에 알림 접근을 바로 켤 수 없습니다. 아래 ‘앱 정보 열기’를 누른 뒤 오른쪽 위 더보기(⋮) &gt; ‘제한된 설정 허용’을 누르고, 다시 알림 접근 설정을 열어 주세요.</string>
    <string name="detection_open_app_details">앱 정보 열기</string>
    <string name="detection_post_notifications_title">알림 권한도 필요합니다</string>
    <string name="detection_post_notifications_body">재난문자를 감지하면 ‘위치를 공유할까요?’ 알림으로 여쭤봅니다. 이 알림을 띄우려면 알림 권한이 필요합니다.</string>
    <string name="detection_post_notifications_button">알림 권한 허용</string>
    <string name="detection_post_notifications_granted">알림 권한이 켜져 있습니다.</string>

    <!-- 발동 규칙 -->
    <string name="rules_title">발동 규칙</string>
    <string name="rules_intro">문자 종류마다 발동할지 정하고, 발동할 재난 유형을 골라 주세요. 발동하면 ‘위치를 공유할까요?’ 알림을 띄웁니다.</string>
    <string name="rules_types_title">발동할 재난 유형</string>
    <string name="rules_types_summary">%1$d / %2$d개 선택</string>
    <string name="rules_select_all">모두 선택</string>
    <string name="rules_clear_all">모두 해제</string>
    <string name="rules_reset">기본값으로 되돌리기</string>
    <string name="rules_notice_unknown_severity">‘새 경보’, ‘읽지 않은 경보 3개’처럼 본문이 없는 묶음 알림은 문자 종류를 알 수 없어 발동하지 않습니다.</string>
    <string name="rules_notice_unknown_type">본문이 없거나 가려져서 재난 유형을 알 수 없을 때는 ‘기타’ 설정을 따릅니다.</string>
    <string name="rules_notice_dedupe">같은 문자가 여러 번 오거나 언어별 사본이 와도 %1$d분 안에는 한 번만 발동합니다.</string>

    <!-- 발동 기록 -->
    <string name="alert_log_title">발동 기록</string>
    <string name="alert_log_subtitle">최근 %1$d건까지 보여 줍니다.</string>
    <string name="alert_log_empty_title">아직 기록이 없습니다</string>
    <string name="alert_log_empty_description">재난문자 앱이 알림을 띄우면 여기에 쌓입니다. 디버그 빌드에서는 설정 &gt; 테스트 재난문자 보내기로 미리 확인할 수 있습니다.</string>
    <string name="alert_log_clear">기록 모두 지우기</string>
    <string name="alert_log_notice">본문은 앞 %1$d자까지만 기록하고 %2$d일이 지나면 지웁니다. 이 기록은 서버로 보내지 않습니다.</string>
    <string name="alert_log_triggered">발동</string>
    <string name="alert_log_not_triggered">발동 안 함</string>
    <string name="alert_log_meta">%1$s · 신뢰도 %2$s</string>
    <string name="alert_log_category">재난구분 %1$s</string>
