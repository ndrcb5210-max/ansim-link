<?xml version="1.0" encoding="utf-8"?>
<!--
  CLAUDE.md 원칙 4(최소 수집)에 맞춰 클라우드 백업과 기기 간 전송에서 앱 데이터를 모두 뺀다.
  위치·동의 기록이 백업으로 다른 기기에 옮겨 가지 않게 한다.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
