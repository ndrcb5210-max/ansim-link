<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 이하(API 26~30)용 백업 규칙. allowBackup="false" 라서 실제로는 백업이 돌지 않지만,
  의도를 분명히 하려고 모든 영역을 빼 둔다. Android 12 이상은 data_extraction_rules.xml 을 쓴다.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
