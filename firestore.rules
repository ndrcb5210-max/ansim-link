rules_version = '2';

// 안심연결 Firestore 보안 규칙 (2·4단계)
//
// 문서 구조는 app/.../data/FirestoreSchema.kt 주석과 같다. 한쪽만 고치면 안 된다.
// 규칙 테스트는 tests/rules/ 에 있다.
//
// 핵심 원칙
// 1. 그룹 구성원만 그 그룹과 구성원 문서를 읽는다.
// 2. 자기 구성원 문서만 쓴다. 남의 공유 상태를 바꿀 수 없다.
// 3. 유효한 초대 코드가 있어야만 그룹에 들어온다.
// 4. 위치 제공에 동의하지 않으면 구성원이 될 수 없다(consent.location == true 강제).
// 5. (4단계) 위치는 **동의했고 일시중지가 아닌 본인만** 쓴다. 규칙에서 막는다.
//    앱 코드가 틀려도 동의 없는 위치가 서버에 올라가지 못하게 하려는 것이다.
// 6. (4단계) 안심 메시지는 그룹 구성원이 자기 이름으로만 만든다. 남의 이름으로 보낼 수 없다.
// 7. (4단계) 제공 내역(provisionLogs)은 **고칠 수 없다.** 종료 시각만 한 번 채운다.
//    위치정보법 제16조의 '확인자료'라서 나중에 바꿀 수 있으면 뜻이 없다.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isSelf(userId) {
      return signedIn() && uid() == userId;
    }

    function groupData(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)).data;
    }

    function groupExists(groupId) {
      return exists(/databases/$(database)/documents/groups/$(groupId));
    }

    // 다른 컬렉션에서 그룹 소속을 확인할 때 쓴다(읽기 1회 비용이 든다).
    function isGroupMember(groupId) {
      return signedIn() && groupExists(groupId) && uid() in groupData(groupId).memberUids;
    }

    function isGroupOwner(groupId) {
      return signedIn() && groupExists(groupId) && groupData(groupId).ownerUid == uid();
    }

    // 프리미엄 최대 인원. 요금제별 한도(무료 3명)는 앱과 5단계 서버에서 보고,
    // 규칙에서는 어떤 경우에도 넘을 수 없는 상한만 막는다.
    function withinMemberCap(memberUids) {
      return memberUids.size() <= 10;
    }

    // 초대 코드가 이 그룹의 것이고 아직 살아 있는지.
    function validInvite(groupId, code) {
      return code is string
          && exists(/databases/$(database)/documents/inviteCodes/$(code))
          && get(/databases/$(database)/documents/inviteCodes/$(code)).data.groupId == groupId
          && get(/databases/$(database)/documents/inviteCodes/$(code)).data.expiresAt > request.time.toMillis();
    }

    // ---- users ----
    //
    // 본인만 읽고 쓴다. 그룹 화면에 보이는 이름은 users 가 아니라
    // groups/{gid}/members/{uid}.displayName 에서 가져오므로 남의 users 문서를 읽을 일이 없다.
    //
    // (5단계) 다만 `entitlement` 는 **클라이언트가 쓸 수 없다.** 그 값이 프리미엄을 여는
    // 근거라서(CLAUDE.md 3장: 앱 단독 판단으로 기능을 열지 않는다) 앱이 쓸 수 있으면
    // APK 를 고친 사람이 자기 문서에 state: "active" 를 적어 결제 없이 프리미엄을 쓴다.
    // 서버(Admin SDK)는 보안 규칙을 통과하지 않으므로 verifySubscription 과 RTDN 함수는
    // 이 조건과 무관하게 쓸 수 있다.
    match /users/{userId} {

      // 생성·수정 양쪽에서 entitlement 가 들어오지 않았는지 본다.
      //
      // create 에서는 resource 가 없으므로 '필드가 아예 없어야 한다'로 본다.
      // update 에서는 diff 로 '바뀌지 않았는지'만 본다. 'entitlement 가 없어야 한다'로
      // 두면, 서버가 그 필드를 써 준 뒤에는 사용자가 자기 이름(displayName)도 바꿀 수
      // 없게 된다 — update 의 request.resource.data 는 쓰고 난 뒤의 문서 전체이기 때문이다
      // (4단계 '막힌 점' 2번에서 sharing 으로 똑같이 당했다).
      function entitlementUntouchedOnCreate() {
        return !('entitlement' in request.resource.data);
      }

      function entitlementUnchangedOnUpdate() {
        return !request.resource.data.diff(resource.data)
                  .affectedKeys().hasAny(['entitlement']);
      }

      allow get, list: if isSelf(userId);
      allow create: if isSelf(userId) && entitlementUntouchedOnCreate();
      allow update: if isSelf(userId) && entitlementUnchangedOnUpdate();

      // 계정 삭제는 본인이 한다. 지우면 entitlement 도 같이 사라지는데, 그것으로
      // 프리미엄을 얻을 수는 없다(문서가 없으면 무료다).
      allow delete: if isSelf(userId);

      match /pushTokens/{token} {
        allow read, write: if isSelf(userId);
      }
    }

    // ---- groups ----
    match /groups/{groupId} {

      // 구성원만 읽는다. memberUids 로 거르는 질의여야 목록 조회도 통과한다.
      allow get, list: if signedIn() && uid() in resource.data.memberUids;

      // 만든 사람은 자기 자신만 구성원으로 넣은 그룹을 만들 수 있다.
      allow create: if signedIn()
                    && request.resource.data.keys().hasOnly(
                         ['name', 'ownerUid', 'memberUids', 'createdAt'])
                    && request.resource.data.ownerUid == uid()
                    && request.resource.data.memberUids == [uid()]
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 50;

      // 이름이 그대로이고 구성원 목록도 그대로인지(소유권만 바뀌는 경우).
      function onlyOwnerChanged() {
        return request.resource.data.name == resource.data.name
            && request.resource.data.memberUids == resource.data.memberUids;
      }

      // 이름과 소유자는 그대로이고 구성원 목록만 바뀌는지.
      function onlyMembersChanged() {
        return request.resource.data.name == resource.data.name
            && request.resource.data.ownerUid == resource.data.ownerUid;
      }

      // 내가 나를 구성원 목록에 넣는다. 구성원 문서를 먼저 만들었어야 한다.
      // (그 문서를 만들 때 초대 코드를 검사했다. 배치 쓰기는 '쓰기 전 상태'로 평가되므로
      //  앱에서도 순서대로 두 번 나눠 쓴다.)
      function selfJoining() {
        return onlyMembersChanged()
            && !(uid() in resource.data.memberUids)
            && request.resource.data.memberUids.toSet()
                 == resource.data.memberUids.toSet().union([uid()].toSet())
            && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
            && withinMemberCap(request.resource.data.memberUids)
            && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(uid()));
      }

      // 내가 나를 구성원 목록에서 뺀다(동의 철회).
      function selfLeaving() {
        return onlyMembersChanged()
            && uid() in resource.data.memberUids
            && request.resource.data.memberUids.toSet()
                 == resource.data.memberUids.toSet().difference([uid()].toSet())
            && request.resource.data.memberUids.size() == resource.data.memberUids.size() - 1;
      }

      // 만든 사람이 소유권을 남은 구성원에게 넘긴다.
      function ownerTransferring() {
        return resource.data.ownerUid == uid()
            && onlyOwnerChanged()
            && request.resource.data.ownerUid in resource.data.memberUids
            && request.resource.data.ownerUid != uid();
      }

      allow update: if signedIn()
                    && request.resource.data.keys().hasOnly(
                         ['name', 'ownerUid', 'memberUids', 'createdAt'])
                    && (selfJoining() || selfLeaving() || ownerTransferring());

      // 그룹 해산은 만든 사람만. 남은 구성원의 문서는 앱이 먼저 지운다.
      allow delete: if signedIn() && resource.data.ownerUid == uid();

      // ---- groups/{gid}/members/{uid} ----
      match /members/{memberId} {

        allow read: if isGroupMember(groupId);

        // 위치 제공에 동의해야만 구성원이 된다. 동의하지 않은 사람은 들어올 수 없다.
        function consented() {
          return request.resource.data.consent.location == true
              && request.resource.data.consent.version is string
              && request.resource.data.paused == false;
        }

        // 그룹을 막 만든 사람은 초대 코드 없이 자기 구성원 문서를 만든다.
        // 그 밖의 사람은 살아 있는 초대 코드가 있어야 한다.
        allow create: if isSelf(memberId)
                      && consented()
                      && request.resource.data.displayName is string
                      && (
                           isGroupOwner(groupId)
                           || validInvite(
                                groupId,
                                // 그룹을 만든 사람의 문서에는 이 필드가 없다.
                                request.resource.data.get('joinedWithCode', '')
                              )
                         );

        // 일시중지·재개는 본인만. 동의 자체를 true 로 되돌리는 것도 본인만 할 수 있다.
        //
        // 4단계에서 두 필드가 늘었다. pushToken(FCM 토큰 사본)과 sharing(공유 중 표시)이다.
        // 둘 다 본인만 쓴다.
        //
        // sharing.endsAt 에 상한을 둔 이유: 이 값이 '지금 공유 중인가'의 근거다
        // (GroupMember.sharingNow). 아무 값이나 넣을 수 있으면 10년 뒤를 적어 두고
        // 영원히 '공유 중'으로 보이게 만들 수 있다. 공유는 길어도 180분이므로
        // 여유를 조금 두어 185분으로 막는다.
        //
        // **sharing 이 실제로 바뀔 때만** 검사한다(diff). 'sharing 이 들어 있으면'으로
        // 검사하면 안 된다. update 의 request.resource.data 는 쓰고 난 **뒤의 문서 전체**라서,
        // 앱이 죽어 sharing.active 가 true 로 남고 endsAt 이 과거가 된 상태에서는
        // pushToken 이나 paused 를 고치는 쓰기까지 모두 막힌다. 그러면 사용자가
        // '일시중지'를 누를 수 없게 되어 원칙 1(철회·중지는 즉시)을 어긴다.
        function validSharingWindow() {
          return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['sharing'])
              || request.resource.data.sharing.active == false
              || (
                   request.resource.data.sharing.endsAt is int
                   && request.resource.data.sharing.endsAt
                        <= request.time.toMillis() + 185 * 60 * 1000
                 );
        }

        allow update: if isSelf(memberId)
                      && request.resource.data.displayName == resource.data.displayName
                      && validSharingWindow();

        // 동의 철회는 본인이, 그룹 해산은 만든 사람이 지운다.
        allow delete: if isSelf(memberId) || isGroupOwner(groupId);
      }

      // ---- groups/{gid}/invites/{code} ----
      //
      // 만든 사람이 발급하고 목록으로 보고 지운다. 코드를 받은 사람은 여기가 아니라
      // 최상위 inviteCodes/{code} 를 읽는다(아직 구성원이 아니라 그룹을 읽을 수 없으므로).
      match /invites/{code} {
        allow read, create, delete: if isGroupOwner(groupId);
        allow update: if false;
      }

      // ---- groups/{gid}/locations/{uid} ----
      //
      // 구성원별 **마지막 위치 1건**. 이동 경로를 쌓지 않으므로 문서 ID 가 uid 다.
      //
      // 쓰기 조건이 이 규칙 파일에서 가장 중요하다. 앱 코드에 버그가 있어도
      // 동의하지 않은 사람의 위치가 서버에 올라가서는 안 된다(CLAUDE.md 원칙 1).
      // 그래서 구성원 문서를 읽어(get 1회 비용) 동의와 일시중지를 둘 다 확인한다.
      match /locations/{memberId} {

        function myMemberDocument() {
          return get(
            /databases/$(database)/documents/groups/$(groupId)/members/$(memberId)
          ).data;
        }

        // 동의했고(consent.location == true) 일시중지가 아닌(paused == false) 상태.
        // paused 까지 보는 이유: '일시중지'는 위치정보법 제24조의 '수집 일시중지'다.
        // 그 상태에서 위치가 올라가면 법도 사용자 기대도 어긋난다.
        function sharingAllowed() {
          return myMemberDocument().consent.location == true
              && myMemberDocument().paused == false;
        }

        // 보낼 수 있는 필드만. 다른 필드를 끼워 넣어 위치 문서를 다른 용도로
        // 쓰지 못하게 막는다(예: 메모를 붙여 쪽지처럼 쓰는 것).
        function validLocationShape() {
          return request.resource.data.keys().hasOnly(
                   ['lat', 'lng', 'accuracy', 'at', 'sessionId', 'expiresAt'])
              && request.resource.data.lat is number
              && request.resource.data.lng is number
              && request.resource.data.lat >= -90 && request.resource.data.lat <= 90
              && request.resource.data.lng >= -180 && request.resource.data.lng <= 180
              && request.resource.data.at is int
              && request.resource.data.expiresAt is int
              && request.resource.data.sessionId is string;
        }

        allow read: if isGroupMember(groupId);
        allow create, update: if isSelf(memberId)
                             && sharingAllowed()
                             && validLocationShape();
        // 지우는 쪽은 넓게 허용한다. 동의 철회·계정 삭제·그룹 해산 때 지워야 하고,
        // 줄이는 방향은 막을 이유가 없다.
        allow delete: if isSelf(memberId) || isGroupOwner(groupId);
      }

      // ---- groups/{gid}/alerts/{alertId} ----
      //
      // 안심 메시지. 앱이 만들고 서버(onAlertCreated)가 읽어 FCM 으로 보낸다.
      //
      // 고칠 수 없게 둔다(update 금지). 보낸 메시지를 나중에 바꾸면 받은 사람이 본 것과
      // 서버에 남은 것이 달라진다.
      match /alerts/{alertId} {
        allow read: if isGroupMember(groupId);

        allow create: if isGroupMember(groupId)
                      && request.resource.data.keys().hasOnly(
                           ['senderUid', 'senderName', 'severity', 'type',
                            'message', 'sharing', 'createdAt'])
                      // 남의 이름으로 보낼 수 없다.
                      && request.resource.data.senderUid == uid()
                      && request.resource.data.senderName is string
                      && request.resource.data.message is string
                      && request.resource.data.message.size() > 0
                      // 앱의 SafetyMessages.MAX_LENGTH 와 같은 값이다.
                      && request.resource.data.message.size() <= 200
                      && request.resource.data.sharing is bool
                      && request.resource.data.createdAt is int;

        allow update: if false;
        // 받는 쪽이 지울 수는 없다. 보낸 사람과 그룹을 만든 사람만.
        allow delete: if signedIn()
                      && (resource.data.senderUid == uid() || isGroupOwner(groupId));
      }

      // ---- groups/{gid}/provisionLogs/{logId} ----
      //
      // 위치정보법 제19조③의 제공 내역. **좌표가 들어 있지 않다.**
      //
      // 읽기를 본인만으로 좁혔다. 다른 구성원이 '누가 언제 위치를 제공했는지' 목록을
      // 훑을 수 있으면 그것 자체가 감시 도구가 된다(원칙 10). 내 위치가 제공됐다는
      // 사실은 공유 중 표시(members.sharing)로 이미 서로 보인다.
      //
      // 고칠 수 없다. 단 하나, **아직 비어 있는 endedAt 을 한 번 채우는 것**만 허용한다.
      // 종료 시각은 공유가 끝날 때 알 수 있으므로 미리 적을 수 없다.
      match /provisionLogs/{logId} {
        // get 과 list 를 같은 조건으로 둔다. 목록 조회(list)를 아예 막으면 안 되는데,
        // 앱이 공유를 끝낼 때 `uid == 나 && sessionId == 이 세션` 으로 **조회해서**
        // 종료 시각을 채우기 때문이다(FirestoreShareRepository.endSharing).
        // 규칙이 list 를 평가할 때는 질의가 이 조건을 보장해야 통과하므로,
        // 남의 내역을 훑는 질의는 그대로 막힌다.
        allow get, list: if signedIn() && resource.data.uid == uid();

        allow create: if isGroupMember(groupId)
                      && request.resource.data.keys().hasOnly(
                           ['uid', 'sessionId', 'purpose', 'receiverUids',
                            'startedAt', 'plannedEndAt', 'endedAt'])
                      && request.resource.data.uid == uid()
                      && request.resource.data.sessionId is string
                      && request.resource.data.purpose is string
                      && request.resource.data.startedAt is int
                      && request.resource.data.plannedEndAt is int
                      // 만들 때는 반드시 비어 있어야 한다. 처음부터 '끝났다'고 적어 두고
                      // 위치를 보내는 것을 막는다.
                      && request.resource.data.endedAt == null;

        allow update: if signedIn()
                      && resource.data.uid == uid()
                      && resource.data.endedAt == null
                      && request.resource.data.endedAt is int
                      // endedAt 말고는 아무것도 바뀌지 않아야 한다.
                      && request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['endedAt']);

        // 계정 삭제 때도 지우지 않는다. 제16조② 보관 의무가 있고 좌표가 없기 때문이다.
        // 그 사실을 계정 삭제 화면에 적어 두었다(account_delete_retained).
        allow delete: if false;
      }
    }

    // ---- inviteCodes/{code} ----
    //
    // 문서 ID 가 곧 초대 코드다. 그래서 '코드를 아는 사람'만 단건 조회로 읽을 수 있고,
    // 목록 조회(list)는 막는다. 목록을 열어 주면 아무나 모든 초대를 훑을 수 있다.
    match /inviteCodes/{code} {
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
                    && request.resource.data.keys().hasOnly(
                         ['groupId', 'groupName', 'memberNames', 'expiresAt', 'createdBy'])
                    && request.resource.data.createdBy == uid()
                    && request.resource.data.expiresAt is int
                    && isGroupOwner(request.resource.data.groupId);

      allow update: if false;
      allow delete: if signedIn() && isGroupOwner(resource.data.groupId);
    }

    // ---- purchaseTokens ----
    //
    // (5단계) 구매 토큰의 SHA-256 → uid 매핑. **서버만 쓰고 읽는다.**
    //
    // 규칙이 없으면 기본이 거부이므로 이 블록이 없어도 막힌다. 그래도 적어 두는 이유:
    // 나중에 이 컬렉션을 보고 '규칙이 없네, 빠뜨렸나' 하고 열어 주는 일을 막으려는 것이다.
    // 서버(Admin SDK)는 보안 규칙을 통과하지 않으므로 함수는 그대로 쓸 수 있다.
    match /purchaseTokens/{tokenHash} {
      allow read, write: if false;
    }
  }
}
